<?php

if (!defined('DOKU_INC')) {
    exit;
}

use dokuwiki\Extension\ActionPlugin;
use dokuwiki\Extension\EventHandler;

class action_plugin_service_monitor extends ActionPlugin
{
    public function register(EventHandler $controller)
    {
        $controller->register_hook(
            'TPL_METAHEADER_OUTPUT',
            'BEFORE',
            $this,
            'addAssets'
        );
    }

    public function addAssets($event, $param)
    {
        $event->data['script'][] = DOKU_BASE
            . 'lib/plugins/servicemonitor/script.js';

        $event->data['link'][] = [
            'rel' => 'stylesheet',
            'type' => 'text/css',
            'href' => DOKU_BASE
                . 'lib/plugins/servicemonitor/style.css',
        ];
    }
}
